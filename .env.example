# Shared environment variables (copy to .env).
# Client variables are exposed to the browser at build time.
VITE_API_URL=http://localhost:4000/api/v1

# Server (used once the Express app is added).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/nengnanum

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Payment (choose Midtrans or Xendit)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Shipping (choose Biteship or RajaOngkir)
BITESHIP_API_KEY=

# Image storage (choose Cloudinary or Cloudflare R2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
